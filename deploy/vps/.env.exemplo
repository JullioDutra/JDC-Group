# Copie para deploy/vps/.env e preencha (o .env NÃO vai para o Git).
# Os valores são os mesmos da Vercel (Settings > Environment Variables).

# --- Novos na VPS ---
# Subdomínio apontado para o IP da VPS (registro A no DNS), sem https://
DOMAIN=
# Endereço público do bot, com https:// (o QStash chama os prazos das rodadas aqui)
PUBLIC_APP_URL=
# Porta só local na VPS (o proxy repassa para ela)
BOT_PORT=3010
# 127.0.0.1 (proxy instalado na VPS) ou 172.17.0.1 (proxy que roda em container)
BOT_BIND=127.0.0.1
# Traefik que já existe na VPS (docker-compose.traefik.yml): rede, entrada HTTPS e emissor do certificado
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=

# --- Banco (Neon) ---
DATABASE_URL=
POSTGRES_URL=

# --- WhatsApp (Evolution) ---
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Instância do JOGO (nunca a de finanças)
EVOLUTION_INSTANCE=
WEBHOOK_SECRET=
WHATSAPP_REACTIONS=

# --- Admin ---
ADMIN_KEY=
ADMIN_NUMBERS=
OWNER_NUMBERS=
CRON_SECRET=

# --- Prazos das rodadas e carga (QStash / Upstash) ---
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
IMPORT_DAILY_CALLS=

# --- IA (Maritaca) ---
MARITACA_API_KEY=
MARITACA_BASE_URL=
MARITACA_MODEL=
MARITACA_FAST_MODEL=

# --- Transfermarkt (opcional) ---
TM_SITE=
