# --- Banco (Neon / Vercel Postgres) ---
DATABASE_URL=

# --- IA (Maritaca) ---
MARITACA_API_KEY=
# sabia-4 = mais preciso · sabiazinho-4 = mais rápido/barato
MARITACA_MODEL=sabia-4
MARITACA_BASE_URL=https://chat.maritaca.ai/api

# --- WhatsApp: "evolution" ou "zapi" ---
WHATSAPP_PROVIDER=evolution
# Segredo que vai na URL do webhook: /api/webhook?token=...
WEBHOOK_SECRET=

# Evolution API v2
# URL pública (HTTPS) do seu servidor Evolution
EVOLUTION_API_URL=
# Use o TOKEN DA INSTÂNCIA do jogo (não a chave global): ele só enxerga essa instância
EVOLUTION_API_KEY=
# Nome exato da instância do número do jogo (o antigo do RPG)
EVOLUTION_INSTANCE=

# Números (com DDI, só dígitos, separados por vírgula) que podem mandar "ativar grupo"
OWNER_NUMBERS=

# Z-API
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Simulador web (/jogar) e rota de migração ---
# Chave exigida em /jogar e em /api/admin/migrate
ADMIN_KEY=
