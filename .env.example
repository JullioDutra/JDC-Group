# --- Banco (Neon / Vercel Postgres) ---
DATABASE_URL=

# --- IA (Maritaca) ---
MARITACA_API_KEY=
# sabia-4 = mais preciso · sabiazinho-4 = mais rápido/barato
MARITACA_MODEL=sabia-4
MARITACA_BASE_URL=https://chat.maritaca.ai/api

# --- WhatsApp: "evolution" ou "zapi" ---
WHATSAPP_PROVIDER=evolution
# Segredo que vai na URL do webhook: /api/webhook?token=...
WEBHOOK_SECRET=

# Evolution API v2
# URL pública (HTTPS) do seu servidor Evolution
EVOLUTION_API_URL=
# Use o TOKEN DA INSTÂNCIA do jogo (não a chave global): ele só enxerga essa instância
EVOLUTION_API_KEY=
# Nome exato da instância do número do jogo (recomendado: jogos; ver docs/VIRADA-VPS.md)
EVOLUTION_INSTANCE=

# Números de ADMIN (com DDI, só dígitos, separados por vírgula). Só eles mandam
# "ativar grupo"/"desativar grupo" (de dentro do grupo). Vazio = ninguém ativa.
ADMIN_NUMBERS=

# Z-API
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- Modo em Grupo: prazos das rodadas (Upstash QStash) ---
# Sem estas variáveis o jogo funciona, mas a rodada vencida só fecha na próxima mensagem.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Endereço público do app (o mesmo usado pelo QStash para chamar /api/tick)
PUBLIC_APP_URL=https://duelo-de-craques-peach.vercel.app

# --- Simulador web (/jogar) e rota de migração ---
# Chave exigida em /jogar e em /api/admin/migrate
ADMIN_KEY=
